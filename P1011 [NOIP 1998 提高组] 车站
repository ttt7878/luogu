def shuru():
    a,n,m,x = map(int,input().split())
    return a,n,m,x
def shuan(a,n,m,x):
    for t in range(m+1):
        up = [0] * (n + 1)
        down = [0] * (n + 1)
        end = [0] * (n + 1)
        up[1] = a
        down[1] = 0
        end[1] = a
        up[2] = t
        down[2] = t
        end[2] = a
        for i in range(3,n):
            up[i] = up[i-2] + up[i-1]
            down[i] = up[i-1]
            end[i] = end[i-1] + up[i] - down[i]
        if end[n-1] == m:
            if x == n:
                return 0
            return end[x]
def main():
    a,n,m,x = shuru()
    end = shuan(a,n,m,x)
    print(end)
if __name__ == "__main__":
    main()